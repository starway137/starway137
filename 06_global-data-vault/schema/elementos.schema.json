{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "archimorph/elementos.schema.json",
  "title": "Fila de data/elementos.csv",
  "type": "object",
  "required": ["element_id", "nombre", "tipo", "es_masa_portante", "forma_planta", "largo_m", "ancho_m",
               "material", "fecha_aprox", "calidad_dato", "incertidumbre_rel", "fuente_id"],
  "properties": {
    "element_id": {"type": "string", "pattern": "^(AW|KL|AY|MD|SN)-[A-Z][0-9]{2}$"},
    "nombre": {"type": "string", "minLength": 1},
    "tipo": {"type": "string", "minLength": 1},
    "nivel_jerarquico": {"type": ["integer", "null"], "minimum": 0},
    "es_masa_portante": {"enum": [0, 1]},
    "forma_planta": {"enum": ["rect", "cuadrado", "circulo"]},
    "largo_m": {"type": "number", "exclusiveMinimum": 0},
    "ancho_m": {"type": "number", "exclusiveMinimum": 0},
    "alto_m": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "factor_volumen": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1},
    "material": {"type": "string"},
    "fase": {"type": "string"},
    "fecha_aprox": {"type": "integer"},
    "calidad_dato": {"enum": ["A", "B", "C"]},
    "incertidumbre_rel": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "fuente_id": {"type": "string", "pattern": "^[A-Z]{2}-[0-9]{2}$"},
    "notas": {"type": "string"}
  },
  "allOf": [
    {"if": {"properties": {"es_masa_portante": {"const": 1}}},
     "then": {"required": ["alto_m", "factor_volumen"]}}
  ]
}
